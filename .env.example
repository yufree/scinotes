# scinotes runtime configuration
# Copy this file to ".env" in your wiki directory or working dir, then fill in values.
# `scinotes init <wiki-path>` will write a copy of this template alongside your wiki.

# ============================================================
# Language & wiki location
# ============================================================
# Bot system-prompt language. Currently supported: en | zh-CN
BOT_LANG=en

# Path to your markdown wiki (created by `scinotes init`)
WIKI_PATH=/path/to/your/wiki

# ============================================================
# Frontends — at least one must be configured
# ============================================================
# Comma-separated list of frontends to start. Default: telegram
# Available: telegram, qq, cli
# `cli` runs an interactive REPL in the terminal, good for first-run testing.
FRONTENDS=telegram

# ----- Telegram -----
# Create a bot via @BotFather (https://t.me/BotFather) to get a token.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID — only this user can talk to the bot.
# Get yours by messaging @userinfobot. LEAVING THIS EMPTY DENIES ALL MESSAGES.
TELEGRAM_USER_ID=

# ----- QQ (mainland China only; requires QQ Open Platform application) -----
# QQ_APP_ID=
# QQ_APP_SECRET=
# QQ_ALLOWED_OPENID=

# ============================================================
# LLM models — at least one must be configured
# ============================================================
# Leave both commented to auto-derive:
#   DEFAULT_MODEL     → "ollama" if reachable, else first cloud model with key
#   FALLBACK_CHAIN    → all configured models, default-first
# DEFAULT_MODEL=ollama
# FALLBACK_CHAIN=ollama,claude

# ----- Ollama (local; auto-skipped if unreachable) -----
# Set OLLAMA_DISABLE=1 on a VPS that has no local inference.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120
# OLLAMA_DISABLE=1

# ----- Claude (Anthropic) -----
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# ----- OpenAI-compatible providers (GLM, MiMo, DeepSeek, etc.) -----
# Pattern: each provider needs MODEL, BASE, KEY env vars wired into MODELS in core.py.
# GLM (智谱):
# GLM_API_KEY=
# GLM_MODEL=GLM-4
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Xiaomi MiMo (in-China):
# MIMO_API_KEY=
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# ============================================================
# Optional external MCP servers (auto-launched if installed)
# ============================================================
# PubMed (NCBI). Optional API key avoids rate limits.
# NCBI_API_KEY=

# Semantic Scholar (papers + citations).
# SEMANTIC_SCHOLAR_API_KEY=

# Zotero (uses zotero-mcp-server; install via `uv tool install zotero-mcp-server`)
# Web mode (recommended):
# ZOTERO_LIBRARY_ID=
# ZOTERO_LIBRARY_TYPE=user
# ZOTERO_API_KEY=
# Or local mode (requires Zotero desktop app running):
# ZOTERO_LOCAL=true

# ============================================================
# Optional integrations
# ============================================================
# Brave Search (web fallback)
# BRAVE_API_KEY=

# Groq (audio transcription, optional)
# GROQ_API_KEY=
